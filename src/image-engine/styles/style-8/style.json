{
  "schema": 1,
  "name": "style-8",
  "title": "Black holographic",
  "description": "Pure black, thin rules, light sans text and one lavender accent, for modern tech, product and AI topics.",
  "suits": {
    "tones": [
      "expert",
      "modern",
      "premium"
    ],
    "keywords": [
      "ai",
      "tech",
      "product",
      "software",
      "future",
      "design",
      "startup",
      "data",
      "launch",
      "update",
      "feature",
      "tool",
      "automation",
      "build"
    ],
    "slideTypes": [
      "cover",
      "content",
      "stat"
    ]
  },
  "version": "1.0.0",
  "basedOn": {
    "cluster": "none",
    "note": "Style 8 of the source packs (REFS/Styles): colours, type mood, case and rhythm read by eye and by sampling the rendered slides. No picture, illustration or layout is copied."
  },
  "palettes": {
    "black": {
      "bg": "#000000",
      "text": "#FFFFFF",
      "muted": "#A6A6A6",
      "accent": "#DA88F4",
      "onAccent": "#000000",
      "marker": "#DA88F4",
      "onMarker": "#000000",
      "surface": "#161616",
      "onSurface": "#FFFFFF",
      "line": "#3A3A3A"
    }
  },
  "rhythm": [
    "black"
  ],
  "byType": {
    "closing": "black"
  },
  "fonts": {
    "headline": "Hanken Grotesk",
    "headlineWeight": 500,
    "body": "Hanken Grotesk",
    "bodyWeight": 300,
    "strong": 500
  },
  "type": {
    "cover": 150,
    "headline": 96,
    "body": 42,
    "small": 34,
    "stat": 320,
    "quote": 74,
    "label": 32
  },
  "caseStyle": "sentence",
  "headlineLineHeight": 1,
  "shape": {
    "radius": 12,
    "outline": 2,
    "stroke": 3,
    "badge": "circle",
    "marker": "underline",
    "sticker": "pill",
    "hardShadow": 0,
    "decor": "rings"
  },
  "spacing": {
    "margin": 80,
    "gap": 24,
    "section": 52
  },
  "chrome": "none",
  "layouts": {
    "cover": [
      {
        "use": "cover-stack",
        "when": {
          "headlineWordsMax": 7
        },
        "params": {}
      },
      {
        "use": "cover-top",
        "params": {
          "visual": "none",
          "kicker": "label"
        }
      }
    ],
    "content": [
      {
        "use": "content-bar",
        "when": {
          "bodyWordsMax": 17
        }
      },
      {
        "use": "content-stack",
        "params": {
          "ruleWidth": 120
        }
      }
    ],
    "step": [
      {
        "use": "step-pill",
        "when": {
          "occurrence": "odd"
        }
      },
      {
        "use": "step-badge",
        "params": {
          "badgeSize": 160
        }
      }
    ],
    "stat": [
      {
        "use": "stat-giant",
        "when": {
          "valueCharsMax": 3
        }
      },
      {
        "use": "stat-card"
      }
    ],
    "checklist": [
      {
        "use": "checklist-lines",
        "when": {
          "itemsMin": 4
        }
      },
      {
        "use": "checklist-icons"
      }
    ],
    "beforeafter": [
      {
        "use": "ba-split",
        "when": {
          "occurrence": "odd"
        }
      },
      {
        "use": "ba-cards"
      }
    ],
    "quote": [
      {
        "use": "quote-centre",
        "when": {
          "quoteCharsMin": 48
        }
      },
      {
        "use": "quote-marks"
      }
    ],
    "closing": [
      {
        "use": "closing-button",
        "when": {
          "headlineWordsMax": 4
        }
      },
      {
        "use": "closing-bar"
      }
    ]
  },
  "assets": {},
  "library": {
    "note": "Tokens for the layout library (designLibrary.ts); the app template route ignores them.",
    "flavour": {
      "cover": "statement",
      "coverVariant": 0,
      "prefer": [
        "statement",
        "lead-statement",
        "big-stat",
        "split-text",
        "stat-bar",
        "quote"
      ],
      "avoid": [
        "numbered-list",
        "listicle-numeral",
        "checklist"
      ],
      "variants": {
        "statement": 0,
        "big-stat": 1,
        "quote": 0
      }
    }
  }
}
