{
  "schema": 1,
  "name": "style-1",
  "title": "Mono editorial glow",
  "description": "Black and white pages with a soft yellow glow, a clean sans headline and calm body copy, for essays and expert takes.",
  "suits": {
    "tones": [
      "expert",
      "calm",
      "clear"
    ],
    "keywords": [
      "essay",
      "thoughts",
      "insight",
      "lesson",
      "story",
      "opinion",
      "founder",
      "writing",
      "learn",
      "think",
      "idea",
      "mindset",
      "quote",
      "book",
      "why"
    ],
    "slideTypes": [
      "content",
      "quote",
      "cover"
    ]
  },
  "version": "1.0.0",
  "basedOn": {
    "cluster": "none",
    "note": "Style 1 of the source packs (REFS/Styles): colours, type mood, case and rhythm read by eye and by sampling the rendered slides. No picture, illustration or layout is copied."
  },
  "palettes": {
    "dark": {
      "bg": "#000000",
      "text": "#FAFAFA",
      "muted": "#B5B2A6",
      "accent": "#FAECA8",
      "onAccent": "#000000",
      "marker": "#FAECA8",
      "onMarker": "#000000",
      "surface": "#16140D",
      "onSurface": "#FAFAFA",
      "line": "#FAFAFA"
    },
    "light": {
      "bg": "#FAFAFA",
      "text": "#0A0A0A",
      "muted": "#55534A",
      "accent": "#0A0A0A",
      "onAccent": "#FAECA8",
      "marker": "#FAECA8",
      "onMarker": "#0A0A0A",
      "surface": "#F1EEE3",
      "onSurface": "#0A0A0A",
      "line": "#0A0A0A"
    }
  },
  "rhythm": [
    "dark",
    "light",
    "light",
    "dark",
    "light",
    "dark"
  ],
  "byType": {
    "closing": "dark"
  },
  "fonts": {
    "headline": "Instrument Sans",
    "headlineWeight": 600,
    "body": "EB Garamond",
    "bodyWeight": 400,
    "strong": 500
  },
  "type": {
    "cover": 112,
    "headline": 84,
    "body": 42,
    "small": 32,
    "stat": 300,
    "quote": 72,
    "label": 32,
    "note": 34,
    "byline": 32
  },
  "caseStyle": "sentence",
  "headlineLineHeight": 1,
  "shape": {
    "radius": 8,
    "outline": 2,
    "stroke": 4,
    "badge": "circle",
    "marker": "box",
    "sticker": "pill",
    "hardShadow": 0,
    "decor": "orbs"
  },
  "spacing": {
    "margin": 80,
    "gap": 24,
    "section": 52
  },
  "chrome": "page-number",
  "layouts": {
    "cover": [
      {
        "use": "cover-stack",
        "when": {
          "headlineWordsMax": 7
        },
        "params": {}
      },
      {
        "use": "cover-top",
        "params": {
          "visual": "none",
          "kicker": "label"
        }
      }
    ],
    "content": [
      {
        "use": "content-bar",
        "when": {
          "bodyWordsMax": 17
        }
      },
      {
        "use": "content-stack",
        "params": {
          "ruleWidth": 120
        }
      }
    ],
    "step": [
      {
        "use": "step-pill",
        "when": {
          "occurrence": "odd"
        }
      },
      {
        "use": "step-badge",
        "params": {
          "badgeSize": 160
        }
      }
    ],
    "stat": [
      {
        "use": "stat-giant",
        "when": {
          "valueCharsMax": 3
        }
      },
      {
        "use": "stat-card"
      }
    ],
    "checklist": [
      {
        "use": "checklist-lines",
        "when": {
          "itemsMin": 4
        }
      },
      {
        "use": "checklist-icons"
      }
    ],
    "beforeafter": [
      {
        "use": "ba-split",
        "when": {
          "occurrence": "odd"
        }
      },
      {
        "use": "ba-cards"
      }
    ],
    "quote": [
      {
        "use": "quote-centre",
        "when": {
          "quoteCharsMin": 48
        }
      },
      {
        "use": "quote-marks"
      }
    ],
    "closing": [
      {
        "use": "closing-button",
        "when": {
          "headlineWordsMax": 4
        }
      },
      {
        "use": "closing-bar"
      }
    ]
  },
  "assets": {},
  "library": {
    "byType": { "cover": { "layouts": ["cover-ruled", "cover-index", "cover-centred", "statement"] } },
    "note": "Tokens for the layout library (designLibrary.ts); the app template route ignores them.",
    "flavour": {
      "cover": "statement",
      "coverVariant": 1,
      "prefer": [
        "statement",
        "prose",
        "numbered-stagger",
        "quote",
        "lead-statement",
        "cta-button",
        "split-text"
      ],
      "avoid": [
        "stat-grid",
        "card-grid",
        "feature-slider",
        "timeline",
        "pill-stagger",
        "statement-pill",
        "statement-stacked"
      ],
      "variants": {
        "statement": 1,
        "quote": 1,
        "prose": 0,
        "numbered-stagger": 0
      }
    },
    "devices": {
      "glow": {
        "corner": "br",
        "color": "#FAECA8"
      },
      "sideLabel": true,
      "pageIndex": true,
      "footerRow": true,
      "art": [
        {
          "item": "style-1/background-1",
          "zone": "corner-tr",
          "w": 520,
          "bleed": 0.35
        },
        {
          "item": "style-1/background-2",
          "zone": "corner-bl",
          "w": 600,
          "bleed": 0.4,
          "opacity": 0.25
        },
        {
          "item": "style-1/background-3",
          "zone": "corner-br",
          "w": 480,
          "bleed": 0.35
        }
      ]
    }
  }
}
