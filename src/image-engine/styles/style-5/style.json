{
  "schema": 1,
  "name": "style-5",
  "title": "Green elegant serif",
  "description": "White pages and a deep green rounded card, an upright serif with italic accent words, for thoughtful, personal teaching.",
  "suits": {
    "tones": [
      "calm",
      "expert",
      "warm"
    ],
    "keywords": [
      "reflect",
      "story",
      "wellbeing",
      "coach",
      "leadership",
      "think",
      "learn",
      "life",
      "growth",
      "habit",
      "mindset",
      "journal",
      "sustainable",
      "finance"
    ],
    "slideTypes": [
      "quote",
      "content",
      "cover"
    ]
  },
  "version": "1.0.0",
  "basedOn": {
    "cluster": "none",
    "note": "Style 5 of the source packs (REFS/Styles): colours, type mood, case and rhythm read by eye and by sampling the rendered slides. No picture, illustration or layout is copied."
  },
  "palettes": {
    "white": {
      "bg": "#FFFFFF",
      "text": "#00225B",
      "muted": "#4A5C80",
      "accent": "#16694B",
      "onAccent": "#FFFFFF",
      "marker": "#16694B",
      "onMarker": "#FFFFFF",
      "surface": "#E3F0EA",
      "onSurface": "#00225B",
      "line": "#16694B"
    },
    "green": {
      "bg": "#1E8563",
      "text": "#FFFFFF",
      "muted": "#FFFFFF",
      "accent": "#FFFFFF",
      "onAccent": "#1E8563",
      "marker": "#FFFFFF",
      "onMarker": "#1E8563",
      "surface": "#2B9473",
      "onSurface": "#FFFFFF",
      "line": "#FFFFFF"
    }
  },
  "rhythm": [
    "green",
    "white",
    "white",
    "green",
    "white",
    "white"
  ],
  "byType": {
    "closing": "white"
  },
  "fonts": {
    "headline": "EB Garamond",
    "headlineWeight": 600,
    "body": "EB Garamond",
    "bodyWeight": 500,
    "strong": 500
  },
  "type": {
    "cover": 128,
    "headline": 92,
    "body": 44,
    "small": 32,
    "stat": 300,
    "quote": 78,
    "label": 32,
    "note": 34,
    "byline": 32
  },
  "caseStyle": "sentence",
  "headlineLineHeight": 1,
  "shape": {
    "radius": 44,
    "outline": 2,
    "stroke": 4,
    "badge": "circle",
    "marker": "underline",
    "sticker": "pill",
    "hardShadow": 0,
    "decor": "orbs"
  },
  "spacing": {
    "margin": 80,
    "gap": 24,
    "section": 52
  },
  "chrome": "none",
  "layouts": {
    "cover": [
      {
        "use": "cover-stack",
        "when": {
          "headlineWordsMax": 7
        },
        "params": {}
      },
      {
        "use": "cover-top",
        "params": {
          "visual": "none",
          "kicker": "label"
        }
      }
    ],
    "content": [
      {
        "use": "content-bar",
        "when": {
          "bodyWordsMax": 17
        }
      },
      {
        "use": "content-stack",
        "params": {
          "ruleWidth": 120
        }
      }
    ],
    "step": [
      {
        "use": "step-pill",
        "when": {
          "occurrence": "odd"
        }
      },
      {
        "use": "step-badge",
        "params": {
          "badgeSize": 160
        }
      }
    ],
    "stat": [
      {
        "use": "stat-giant",
        "when": {
          "valueCharsMax": 3
        }
      },
      {
        "use": "stat-card"
      }
    ],
    "checklist": [
      {
        "use": "checklist-lines",
        "when": {
          "itemsMin": 4
        }
      },
      {
        "use": "checklist-icons"
      }
    ],
    "beforeafter": [
      {
        "use": "ba-split",
        "when": {
          "occurrence": "odd"
        }
      },
      {
        "use": "ba-cards"
      }
    ],
    "quote": [
      {
        "use": "quote-centre",
        "when": {
          "quoteCharsMin": 48
        }
      },
      {
        "use": "quote-marks"
      }
    ],
    "closing": [
      {
        "use": "closing-button",
        "when": {
          "headlineWordsMax": 4
        }
      },
      {
        "use": "closing-bar"
      }
    ]
  },
  "assets": {},
  "library": {
    "note": "Tokens for the layout library (designLibrary.ts); the app template route ignores them.",
    "flavour": {
      "cover": "statement-card",
      "coverVariant": 0,
      "prefer": [
        "statement-card",
        "prose",
        "lead-statement",
        "quote",
        "split-text",
        "statement-question"
      ],
      "avoid": [
        "stat-grid",
        "card-grid",
        "feature-slider",
        "step-numeral",
        "pill-stagger",
        "statement-stacked"
      ],
      "variants": {
        "statement-card": 0,
        "prose": 0,
        "quote": 0
      }
    },
    "devices": {
      "insetCard": {
        "page": "#FFFFFF",
        "margin": 28,
        "radius": 40
      },
      "italicAccent": true,
      "art": [
        {
          "item": "style-5/divider-1",
          "zone": "divider-low",
          "w": 150
        },
        {
          "item": "style-5/corner-1",
          "zone": "corner-br",
          "w": 66
        }
      ]
    },
    "byType": { "cover": { "layouts": ["statement-card", "cover-centred", "cover-ruled", "cover-block"], "signature": "statement-card" },
      "closing": {
        "layout": "statement-card",
        "variant": 1,
        "avoid": [
          "headline-card",
          "prose",
          "split-text",
          "lead-statement",
          "numbered-stagger",
          "bullet-list"
        ]
      }
    }
  }
}
