{
  "schema": 1,
  "name": "film-paper",
  "title": "Film photo and paper",
  "description": "Warm film-look photos with lime type, polaroids, tickets and cream paper, for personal, creative stories.",
  "suits": {
    "tones": [
      "warm",
      "personal",
      "playful"
    ],
    "keywords": [
      "story",
      "journey",
      "travel",
      "moments",
      "creative",
      "creators",
      "life",
      "day",
      "memories",
      "community",
      "mood",
      "vibe",
      "ideas",
      "habits"
    ],
    "slideTypes": [
      "cover",
      "content",
      "quote"
    ]
  },
  "version": "1.0.0",
  "basedOn": {
    "cluster": "editorial-collage",
    "note": "The dark film-photo decks of the editorial group: full-bleed photos with lime and cream type over them, a flower-shaped crop on a cream slide, a boarding-pass and a polaroid as objects. The editorial-collage style already holds the collage side; this one adds the photo side."
  },
  "palettes": {
    "film": {
      "bg": "#12100D",
      "text": "#F3EFE4",
      "muted": "#D3CDBE",
      "accent": "#D6F24B",
      "onAccent": "#12100D",
      "marker": "#D6F24B",
      "onMarker": "#12100D",
      "surface": "#24211B",
      "onSurface": "#F3EFE4",
      "line": "#F3EFE4"
    },
    "cream": {
      "bg": "#F1EBDC",
      "text": "#15130F",
      "muted": "#4C473C",
      "accent": "#B1361C",
      "onAccent": "#F1EBDC",
      "marker": "#D6F24B",
      "onMarker": "#15130F",
      "surface": "#E3DAC4",
      "onSurface": "#15130F",
      "line": "#15130F"
    },
    "lime": {
      "bg": "#D6F24B",
      "text": "#12100D",
      "muted": "#2F3410",
      "accent": "#12100D",
      "onAccent": "#D6F24B",
      "marker": "#12100D",
      "onMarker": "#D6F24B",
      "surface": "#12100D",
      "onSurface": "#D6F24B",
      "line": "#12100D"
    }
  },
  "rhythm": [
    "film",
    "cream",
    "film",
    "lime",
    "film",
    "cream"
  ],
  "byType": {
    "cover": "film",
    "stat": "film",
    "quote": "film",
    "closing": "lime"
  },
  "fonts": {
    "headline": "Schibsted Grotesk",
    "headlineWeight": 800,
    "body": "Instrument Sans",
    "bodyWeight": 500,
    "strong": 600
  },
  "type": {
    "cover": 142,
    "headline": 98,
    "body": 44,
    "small": 34,
    "stat": 300,
    "quote": 78,
    "label": 32
  },
  "caseStyle": "sentence",
  "headlineLineHeight": 0.98,
  "bodyLineHeight": 1.32,
  "shape": {
    "radius": 22,
    "outline": 3,
    "stroke": 6,
    "badge": "rounded",
    "marker": "box",
    "sticker": "burst",
    "hardShadow": 0,
    "decor": "orbs"
  },
  "spacing": {
    "margin": 72,
    "gap": 24,
    "section": 50
  },
  "chrome": "page-number",
  "layouts": {
    "cover": [
      {
        "use": "cover-photo-full",
        "when": {
          "photo": true,
          "headlineWordsMax": 4
        },
        "palette": "film",
        "params": {
          "treatment": "film",
          "bar": "last",
          "kicker": "sticker"
        }
      },
      {
        "use": "cover-photo-shape",
        "when": {
          "photo": true
        },
        "palette": "cream",
        "params": {
          "treatment": "film-warm",
          "shape": "flower",
          "bar": "last",
          "kicker": "label",
          "side": "right"
        }
      },
      {
        "use": "cover-centre",
        "when": {
          "headlineWordsMax": 7
        },
        "palette": "cream",
        "params": {
          "bar": "last"
        }
      },
      {
        "use": "cover-stack",
        "palette": "lime",
        "params": {
          "bar": "last",
          "kicker": "sticker"
        }
      }
    ],
    "content": [
      {
        "use": "content-photo-strip",
        "when": {
          "photo": true,
          "bodyWordsMax": 11
        },
        "palette": "film",
        "params": {
          "treatment": "film",
          "bar": "last",
          "radius": 16,
          "stripGap": 14
        }
      },
      {
        "use": "content-photo-frame",
        "when": {
          "photo": true,
          "occurrence": "odd"
        },
        "palette": "film",
        "params": {
          "frame": "polaroid",
          "treatment": "film-warm",
          "tilt": -4,
          "bar": "last"
        }
      },
      {
        "use": "content-photo-frame",
        "when": {
          "photo": true
        },
        "palette": "cream",
        "params": {
          "frame": "ticket",
          "treatment": "film-warm",
          "bar": "last"
        }
      },
      {
        "use": "content-bar",
        "when": {
          "bodyWordsMax": 17
        },
        "palette": "cream"
      },
      {
        "use": "content-stack",
        "params": {
          "ruleWidth": 160
        }
      }
    ],
    "step": [
      {
        "use": "step-badge",
        "when": {
          "occurrence": "odd"
        },
        "palette": "cream",
        "params": {
          "badgeSize": 170
        }
      },
      {
        "use": "step-numeral",
        "params": {
          "numeralSize": 340
        }
      }
    ],
    "stat": [
      {
        "use": "stat-photo",
        "when": {
          "photo": true
        },
        "palette": "film",
        "params": {
          "treatment": "film-dark",
          "kicker": "sticker"
        }
      },
      {
        "use": "stat-giant",
        "when": {
          "valueCharsMax": 3
        },
        "palette": "lime"
      },
      {
        "use": "stat-card"
      }
    ],
    "checklist": [
      {
        "use": "checklist-icons",
        "when": {
          "itemsMax": 3
        }
      },
      {
        "use": "checklist-lines"
      }
    ],
    "beforeafter": [
      {
        "use": "ba-cards",
        "when": {
          "occurrence": "odd"
        }
      },
      {
        "use": "ba-split",
        "params": {
          "alt": "cream"
        }
      }
    ],
    "quote": [
      {
        "use": "quote-photo-blur",
        "when": {
          "photo": true
        },
        "palette": "film",
        "params": {
          "treatment": "film-blur"
        }
      },
      {
        "use": "quote-marks",
        "when": {
          "quoteCharsMin": 48
        }
      },
      {
        "use": "quote-centre"
      }
    ],
    "closing": [
      {
        "use": "closing-button",
        "when": {
          "headlineWordsMax": 5
        }
      },
      {
        "use": "closing-bar"
      }
    ]
  },
  "assets": {},
  "photo": {
    "treatments": {
      "film": [
        {
          "op": "levels",
          "contrast": 0.2,
          "saturation": -0.45
        },
        {
          "op": "tint",
          "color": "#D8A45A",
          "amount": 0.12
        },
        {
          "op": "grain",
          "amount": 0.15,
          "size": 1,
          "seed": 3
        },
        {
          "op": "vignette",
          "amount": 0.45
        }
      ],
      "film-dark": [
        {
          "op": "levels",
          "contrast": 0.2,
          "saturation": -0.45,
          "brightness": -0.1
        },
        {
          "op": "tint",
          "color": "#D8A45A",
          "amount": 0.12
        },
        {
          "op": "grain",
          "amount": 0.13,
          "size": 1,
          "seed": 5
        },
        {
          "op": "vignette",
          "amount": 0.5
        }
      ],
      "film-warm": [
        {
          "op": "levels",
          "contrast": 0.1,
          "saturation": -0.25
        },
        {
          "op": "tint",
          "color": "#D8A45A",
          "amount": 0.1
        },
        {
          "op": "grain",
          "amount": 0.1,
          "size": 1,
          "seed": 9
        }
      ],
      "film-blur": [
        {
          "op": "levels",
          "saturation": -0.4,
          "brightness": -0.1
        },
        {
          "op": "blur",
          "radius": 20
        },
        {
          "op": "tint",
          "color": "#D8A45A",
          "amount": 0.1
        },
        {
          "op": "grain",
          "amount": 0.1,
          "size": 1,
          "seed": 2
        }
      ]
    },
    "overlay": "$bg"
  },
  "knownLintConflicts": [],
  "notReproduced": [
    "The tall serif and the hand-written note fonts of the references: only Schibsted Grotesk and Instrument Sans are bundled, so every voice here is a grotesk (headline) or a sans (body).",
    "The paper notes, torn-poster look, tape and stickers on the photos (a ruled to-do note, a pasted poster with tear-off tabs): only the polaroid, the ticket and the flower crop were built; there is no torn-paper or tape drawing yet.",
    "People as the subject. The references put a person in nearly every photo, often with type tucked behind them; that needs cutouts, and none were supplied. Here the type goes over or beside the photo, never behind a figure.",
    "The airplane window mask and the plastic cup photo: the user's test photos do not include them, and a window-shaped mask was not built."
  ]
}
