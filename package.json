{
  "name": "creator-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "test:image": "playwright test -c tests/image-engine/playwright.config.ts",
    "fetch:models": "node scripts/fetch-models.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "style:read": "node scripts/style-read.mjs",
    "style:aggregate": "node scripts/style-aggregate.mjs",
    "fetch:assets": "node scripts/fetch-assets.mjs"
  },
  "dependencies": {
    "fabric": "^7.4.0",
    "onnxruntime-web": "1.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
