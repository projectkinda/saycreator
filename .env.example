# Copy this file to .env (which is not committed) to turn on the API writer for "Make a carousel".
# The key is read by the dev/production SERVER only. It must never be put in client code, never committed, never logged.
# Leave it empty and the API writer stays off.
ANTHROPIC_API_KEY=
# Optional: which model the API writer uses (default claude-sonnet-5-5).
# CAROUSEL_MODEL=
# The model that writes the SCRIPT (the cheap one; default haiku). Used only for the script.
# WRITER_MODEL=haiku
# The model for DESIGN calls (a new style, redesign a slide). Default: CAROUSEL_MODEL, else sonnet.
# DRAW_MODEL=sonnet
# Optional: full path to the Claude Code command line, for the dev-only writer (found automatically when possible).
# CLAUDE_BIN=

# Optional: picture generation for carousel image slots. Read by the SERVER only; both must be set or it stays off. Never put the key in client code.
IMAGE_API_KEY=
IMAGE_MODEL=
# IMAGE_API_URL=   (default: an OpenAI-style images endpoint)
